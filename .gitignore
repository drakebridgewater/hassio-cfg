# --- Secrets (never commit) ---
secrets.yaml
!secrets.yaml.example

# --- Runtime state (not config-as-code) ---
.storage/
.cloud/
.cache/
.HA_VERSION
.uuid
known_devices.yaml
html5_push_registrations.conf

# --- vscode extension settings ---
.history/

# --- Logs ---
*.log
*.log.*
home-assistant.log*
watchman_report.txt

# --- Databases ---
home-assistant_v2*
*.db
*.db-shm
*.db-wal
music_assistant.db
zigbee.db*
pyozw.sqlite

# --- Protocol-specific config files ---
zwcfg_*.xml
aircast.xml

# --- Directories HA writes to at runtime ---
backups/
themes/
tts/
image/
nest/
media/
ssl/
Abode/

# --- Custom components ---
# Ignoring code, keeping manifests: correct ONLY if every integration here
# is HACS-managed (HACS reinstalls the code; the manifest is enough to
# know what's installed). If you hand-write/modify any of these yourself,
# remove this pair and track custom_components/ directly instead.
custom_components/*
!custom_components/*/manifest.json

ticker_migration_backups/
www/alexa_tts/*
www/community/**/bubble-card-*.json
www/icloud3/*.png

www/**/Plex*/*.jpg

# --- Dashboard/frontend cruft ---
old-dashboards.tar.gz
dashboards.tar.gz
*.tar.gz
NOT_USED/

# HACS-managed frontend resources
www/community/**/*.zip
www/community/**/*.js
www/community/**/*.js.gz

# Images under www/ - scoped to community/ only so custom dashboard
# images you place elsewhere in www/ still get tracked.
www/community/**/*.jpg
www/community/**/*.jpeg
www/community/**/*.png
www/community/**/*.gif
www/community/**/*.svg
www/community/**/*.webp
www/community/**/*.bmp
www/community/**/*.ico

www/**/plex/**/*.jpg

# --- Python cache ---
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.pickle

# --- IDE / editor ---
.vscode/
.idea/
*.swp
**pycharm**

# --- OS specific ---
.DS_Store
Thumbs.db
www/upcoming-media-card-images/plex/Recently_Added_Movies/p132346.jpg

# --- Hosting ---
www/google*.html
