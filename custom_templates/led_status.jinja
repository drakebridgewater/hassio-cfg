{#- Each zone resolved to the colour and effect its switches are showing now. -#}
{%- macro mode_rows() -%}
{%- set tbl = mode_table() | from_json -%}
{%- set ns = namespace(out=[]) -%}
{%- for z in mode_zones() | from_json -%}
  {%- set m = states('sensor.lighting_mode_' ~ z.zone) -%}
  {%- set key = m if m in tbl else 'unknown' -%}
  {%- set t = tbl[key] -%}
  {%- set ns.out = ns.out + [{
      'zone': z.zone, 'name': z.name, 'icon': z.icon, 'floor': z.floor,
      'blocker': z.blocker, 'mode': key,
      'color': t.color, 'effect': t.effect, 'brightness': t.brightness,
      'ui': color_ui(t.color), 'hex': color_hex(t.color),
      'label': t.color | capitalize ~ ' ' ~ effect_label(t.effect),
      'why': t.why }] -%}
{%- endfor -%}
{{- ns.out | to_json -}}
{%- endmacro -%}

{#- Switches no zone owns - LED 4 is held dark on these three. -#}
{%- macro mode_unmapped() -%}
{{- (mode_switch_map() | from_json | selectattr('zone','eq','unmapped')
     | map(attribute='switch') | list) | to_json -}}
{%- endmacro -%}


